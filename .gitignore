# 生成物・キャッシュ（トランスクリプト由来の機密を含み得るため必ず除外）
output/
reports/
cache/
*.html
!docs/**/*.html

# 個人設定（採番規約・案件マッピング等。サンプルは config.example.* で共有）
config.local.*
.env
claude-wt/workspaces.json

# claude-wt のスクショ一時置き場（clip2file が生成・14日で自動掃除）
claude-wt/clips/

# トーストアイコン（session_notify.py --make-icons が純Pythonで自己再生成する生成物）
hooks/toast_icons/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node
node_modules/
dist/

# OS / editor
.DS_Store
Thumbs.db
